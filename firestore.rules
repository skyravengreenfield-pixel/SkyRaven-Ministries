rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Projects collection
    match /projects/{projectId} {
      allow read: if true; // Public read
      allow create, update, delete: if true; // Allow all writes for admin access
    }
    
    // Donations collection
    match /donations/{donationId} {
      allow read: if request.auth != null;
      allow create: if true; // Allow anonymous donations
      allow update, delete: if request.auth != null;
    }
    
    // Expenses collection
    match /expenses/{expenseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
    
    // Prayer Requests collection
    match /prayerRequests/{requestId} {
      allow read: if true; // Public read - everyone can see prayer requests
      allow create: if request.auth != null; // Authenticated users can submit
      allow update: if request.auth != null; // Allow incrementing prayers counter
      allow delete: if false; // Only admins via console
    }
    
    // Ministry Goals collection
    match /ministryGoals/{goalId} {
      allow read: if true; // Public read
      allow create, update, delete: if true; // Allow all writes for admin access
    }
    
    // Settings collection
    match /settings/{settingId} {
      allow read: if true; // Public read
      allow create, update, delete: if true; // Allow all writes for admin access
    }
    
    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null;
      allow create, update: if true; // Allow Cloud Functions to write
      allow delete: if false; // Only via Stripe webhook/Cloud Functions
    }
  }
}
